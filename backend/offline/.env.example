# Runtime login: healthaccess_offline, CRUD on the public schema, never owner/admin.
DATABASE_URL=

# npm run keys:generate. Share CODE_DIGEST_KEY with the future online backend.
CODE_DIGEST_KEY=
DATA_ENCRYPTION_KEY=

# Callback URL: /callbacks/africastalking/<token>/sms/inbound (or sms/delivery,
# ussd, ussd/events). Development accepts callbacks without IP restrictions.
CALLBACK_TOKEN=

# No API key = mock SMS, with no network send. Sandbox username is 'sandbox'.
AT_USERNAME=sandbox
AT_API_KEY=
# The actual two-way shortcode/number, also checked against inbound `to`.
AT_SMS_FROM=
AT_USSD_SERVICE_CODE=

# Optional: direct Vercel AI SDK / OpenRouter. Both required to enable AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SERPER_API_KEY=

NODE_ENV=development
PORT=3001
