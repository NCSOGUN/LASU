                "emergency_eligible": true,
                "sort_order": 30,
                "value": [
                  "Penicillin"
                ],
                "field_version": 1
              },
              {
                "key": "current_medications",
                "label": "Medications",
                "value_type": "STRING_ARRAY",
                "emergency_eligible": true,
                "sort_order": 40,
                "value": [
                  "Paracetamol as needed"
                ],
                "field_version": 1
              },
              {
                "key": "conditions",
                "label": "Conditions",
                "value_type": "STRING_ARRAY",
                "emergency_eligible": true,
                "sort_order": 50,
                "value": [
                  "Asthma"
                ],
                "field_version": 1
              },
              {
                "key": "blood_group",
                "label": "Blood group",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 60,
                "value": "O+",
                "field_version": 1
              },
              {
                "key": "emergency_contact_name",
                "label": "Contact name",
