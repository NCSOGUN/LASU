              }
            ]
          }
        }
      ],
      "curl": "curl -sS -X GET http://localhost:3000/v1/me/emergency-summary -H 'authorization: Bearer <access-jwt>'",
      "notes": []
    },
    {
      "id": "portal-patient-code-get",
      "name": "Get patient code",
      "method": "GET",
      "path": "/me/patient-code",
      "summary": "Return the current 12-digit patient code.",
      "description": "Creates a patient code on first use. The code is stored encrypted and only its digest is indexed. code_version increments on every rotation.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "The current code, version and last rotation time.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "available": true,
            "code": "<patient-code>",
            "code_version": 1,
            "rotated_at": "2026-11-17T16:19:14.675Z"
          }
        }
      ],
      "curl": "curl -sS -X GET http://localhost:3000/v1/me/patient-code -H 'authorization: Bearer <access-jwt>'",
      "notes": [
        "The example replaces the live code with <patient-code>; the real value is 12 numeric digits."
      ]
    },
    {
      "id": "portal-patient-code-rotate",
      "name": "Rotate patient code",
      "method": "POST",
      "path": "/me/patient-code/rotate",
      "summary": "Generate a new patient code and revoke active grants.",
      "description": "Increments code_version, replaces the digest and ciphertext, and revokes every active access grant and read session for the patient. Returns the new code, which must be shared again with practitioners.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "New code and incremented code_version.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "available": true,
            "code": "<patient-code>",
            "code_version": 2,
            "rotated_at": "2026-11-17T16:19:14.682Z"
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/me/patient-code/rotate -H 'authorization: Bearer <access-jwt>'",
      "notes": [
        "All outstanding grant codes and read sessions stop working immediately."
      ]
    },
    {
      "id": "portal-grants-list",
      "name": "List access grants",
      "method": "GET",
      "path": "/me/grants",
      "summary": "List grants created by the patient, newest first.",
      "description": "Returns grant id/grant_id, derived status (active, expired or revoked), expiry, revocation time, creation time, sorted field keys and channels. limit is clamped to 1-100 and defaults to 50.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "queryParams": [
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "1-100; values outside the range are clamped."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Active and revoked grants.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": [
            {
              "id": "e8688af7-ccef-4b28-9776-df8ed14a812f",
              "grant_id": "e8688af7-ccef-4b28-9776-df8ed14a812f",
              "status": "revoked",
              "expires_at": "2026-11-17T16:34:15.179Z",
              "revoked_at": "2026-11-17T16:19:15.189Z",
              "created_at": "2026-11-17T16:19:15.180Z",
              "field_keys": [
                "full_name"
              ],
              "channels": [
                "USSD",
                "WEB_PRACTITIONER"
              ]
            },
            {
              "id": "a9234d39-2af2-4d99-a964-9a6565fae4f7",
              "grant_id": "a9234d39-2af2-4d99-a964-9a6565fae4f7",
              "status": "active",
              "expires_at": "2026-11-17T16:49:14.735Z",
              "revoked_at": null,
              "created_at": "2026-11-17T16:19:14.736Z",
              "field_keys": [
                "allergies",
                "blood_group",
                "current_medications",
                "full_name"
              ],
              "channels": [
                "WEB_PRACTITIONER"
              ]
            }
          ]
        }
      ],
      "curl": "curl -sS -X GET http://localhost:3000/v1/me/grants?limit=50 -H 'authorization: Bearer <access-jwt>'",
      "notes": [
        "status is computed at read time from revoked_at and expires_at."
      ]
    },
    {
      "id": "portal-grants-create",
      "name": "Create an access grant",
      "method": "POST",
      "path": "/me/grants",
      "summary": "Create a short-lived grant code for selected fields.",
      "description": "Validates that every field key is active, de-duplicates keys and channels, and creates an access grant with an 8-digit numeric code. The code is returned once in this response and is only stored as a digest. expires_in_minutes defaults to 30 and is capped at 1440.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "field_keys": [
          "full_name",
          "allergies",
          "current_medications",
          "blood_group"
        ],
        "channels": [
          "WEB_PRACTITIONER"
        ],
        "expires_in_minutes": 30
      },
      "bodyFields": [
        {
          "name": "field_keys",
          "type": "string[]",
          "required": true,
          "description": "1-50 active field keys."
        },
        {
          "name": "channels",
          "type": "string[]",
          "required": false,
          "description": "Subset of WEB_PRACTITIONER and USSD; defaults to [\"WEB_PRACTITIONER\"]."
        },
        {
          "name": "expires_in_minutes",
          "type": "integer",
          "required": false,
          "description": "1-1440; defaults to 30."
        }
      ],
      "responses": [
        {
          "status": 201,
          "label": "Created",
          "description": "Grant metadata and the one-time grant code.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "available": true,
            "id": "a9234d39-2af2-4d99-a964-9a6565fae4f7",
            "grant_id": "a9234d39-2af2-4d99-a964-9a6565fae4f7",
            "code": "<grant-code>",
            "expires_at": "2026-11-17T16:49:14.735Z",
            "created_at": "2026-11-17T16:19:14.736Z",
            "field_keys": [
              "full_name",
              "allergies",
              "current_medications",
              "blood_group"
            ],
            "channels": [
              "WEB_PRACTITIONER"
            ]
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/me/grants -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"field_keys\":[\"full_name\",\"allergies\",\"current_medications\",\"blood_group\"],\"channels\":[\"WEB_PRACTITIONER\"],\"expires_in_minutes\":30}'",
      "notes": [
        "The example replaces the live grant code with <grant-code>; the real value is 8 numeric digits.",
        "400 invalid_field when any key is unknown or inactive."
      ]
    },
    {
      "id": "portal-grants-revoke",
      "name": "Revoke an access grant",
      "method": "DELETE",
      "path": "/me/grants/{id}",
      "summary": "Revoke a grant and its active read sessions.",
      "description": "Marks the grant revoked, increments its version and revokes every read session created from it. Returns 404 not_found when the grant does not belong to the patient.",
      "auth": "bearer",
      "roles": [],
      "pathParams": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "description": "Grant id from POST or GET /me/grants."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "The grant is revoked.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "available": true,
            "revoked": true,
            "id": "e8688af7-ccef-4b28-9776-df8ed14a812f"
          }
        }
      ],
      "curl": "curl -sS -X DELETE http://localhost:3000/v1/me/grants/e8688af7-ccef-4b28-9776-df8ed14a812f -H 'authorization: Bearer <access-jwt>'",
      "notes": [
        "Revocation is idempotent from the client point of view; the endpoint reports revoked true."
      ]
    },
    {
      "id": "portal-access-events",
      "name": "List access events",
      "method": "GET",
      "path": "/me/access-events",
      "summary": "Return the patient audit trail, newest first.",
      "description": "Lists audit events whose patient_id is the current patient. Each entry exposes the channel, action, outcome, optional reason_code, resource type/id and affected field keys. limit is clamped to 1-100 and defaults to 50.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "queryParams": [
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "1-100; values outside the range are clamped."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Audit events for the current patient.",
