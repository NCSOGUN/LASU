              {
                "key": "weight",
                "label": "Weight",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 90,
                "value": "64",
                "field_version": 1
              },
              {
                "key": "height",
                "label": "Height",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 100,
                "value": "168",
                "field_version": 1
              },
              {
                "key": "gender",
                "label": "Gender",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 110,
