      "name": "Get emergency summary",
      "method": "GET",
      "path": "/me/emergency-summary",
      "summary": "Preview the emergency projection shown to a reader.",
      "description": "Returns the current profile version, the ordered emergency field keys and the projected key, label and value for each field. available is false when no emergency fields are configured.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "responses": [
        {
          "status": 200,
          "label": "OK",
