              }
            ]
          }
        }
      ],
      "curl": "curl -sS -X PUT http://localhost:3000/v1/me/fields -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"fields\":{\"full_name\":\"Bola Adeyemi\",\"date_of_birth\":\"1994-11-03\",\"allergies\":[\"Penicillin\"],\"current_medications\":[\"Paracetamol as needed\"],\"conditions\":[\"Asthma\"],\"blood_group\":\"O+\",\"emergency_contact_name\":\"Tunde Adeyemi\",\"emergency_contact_phone\":\"+2348098765433\",\"weight\":\"64\",\"height\":\"168\",\"gender\":\"Female\"},\"expected_version\":1}'",
      "notes": [
        "400 invalid_fields when fields is empty, 400 invalid_value for null values, 400 invalid_field for unknown or inactive keys.",
        "409 version_conflict when expected_version is stale."
      ]
    },
    {
      "id": "portal-emergency-fields-put",
      "name": "Set emergency fields",
      "method": "PUT",
      "path": "/me/emergency-fields",
      "summary": "Replace the ordered list of fields shown in an emergency read.",
      "description": "Each key must be unique, active, emergency_eligible and already have a stored value. The write replaces the whole emergency field list and increments the patient profile version when expected_version matches.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "field_keys": [
          "full_name",
          "allergies",
          "current_medications",
          "blood_group",
          "emergency_contact_name"
        ],
        "expected_version": 2
      },
      "bodyFields": [
        {
          "name": "field_keys",
          "type": "string[]",
          "required": true,
          "description": "Up to 50 unique emergency-eligible field keys with stored values."
        },
        {
          "name": "expected_version",
          "type": "integer",
          "required": true,
          "description": "Current patient profile version."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "The new profile version and ordered field keys.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "version": 3,
            "field_keys": [
              "full_name",
              "allergies",
              "current_medications",
              "blood_group",
              "emergency_contact_name"
            ]
          }
        }
      ],
      "curl": "curl -sS -X PUT http://localhost:3000/v1/me/emergency-fields -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"field_keys\":[\"full_name\",\"allergies\",\"current_medications\",\"blood_group\",\"emergency_contact_name\"],\"expected_version\":2}'",
      "notes": [
        "400 invalid_field when a key is duplicated, inactive, not emergency-eligible or has no stored value."
      ]
    },
    {
