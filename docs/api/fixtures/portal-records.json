      "curl": "curl -sS -X POST http://localhost:3000/v1/records/emergency -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"patient_code\":\"123456789012\"}'",
      "notes": [
        "Denied and throttled reads are audited and return { \"available\": false } with status 200.",
        "The demo patient code 123456789012 is public demo data."
