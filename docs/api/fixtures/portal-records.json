    {
      "id": "portal-consents-put",
      "name": "Create or replace a consent",
      "method": "PUT",
      "path": "/me/consents/{channel}",
      "summary": "Grant SMS or USSD use of selected fields through a verified phone link.",
      "description": "Requires an active ChannelLink for the patient. phone_link_id may select a specific link, otherwise the newest active link is used. Replaces the consent field list, reactivates a revoked consent and increments its version. expires_in_minutes defaults to 30 days.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "pathParams": [
        {
          "name": "channel",
          "type": "string",
          "required": true,
          "description": "SMS or USSD, case-insensitive."
        }
      ],
      "bodyExample": {
        "phone_link_id": "d78eee1c-b9ec-4867-896e-d69cfcd1a1d1",
        "field_keys": [
          "full_name",
          "allergies"
        ],
        "expires_in_minutes": 1440
      },
      "bodyFields": [
        {
          "name": "phone_link_id",
          "type": "uuid",
          "required": false,
          "description": "Specific active ChannelLink; defaults to the newest active link."
        },
        {
          "name": "field_keys",
          "type": "string[]",
          "required": true,
          "description": "1-50 active field keys."
        },
        {
          "name": "expires_in_minutes",
          "type": "integer",
          "required": false,
          "description": "1-525600; defaults to 43200 (30 days)."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Consent metadata and version.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "available": true,
            "consent_id": "19d688bc-8a55-4104-808c-e6a624254512",
            "channel": "SMS",
            "phone_link_id": "d78eee1c-b9ec-4867-896e-d69cfcd1a1d1",
            "expires_at": "2026-11-18T16:19:14.710Z",
            "version": 1,
            "field_keys": [
              "full_name",
              "allergies"
            ]
          }
        },
        {
          "status": 400,
          "label": "Bad Request",
          "description": "No active ChannelLink exists for the patient.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "channel_link_required",
            "message": "An active channel link is required for this consent",
            "request_id": "063d12a5-d0c2-43e2-b3db-85ae23f8cff1"
          }
        }
      ],
      "curl": "curl -sS -X PUT http://localhost:3000/v1/me/consents/sms -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"phone_link_id\":\"d78eee1c-b9ec-4867-896e-d69cfcd1a1d1\",\"field_keys\":[\"full_name\",\"allergies\"],\"expires_in_minutes\":1440}'",
      "notes": [
        "400 invalid_channel for anything other than SMS/USSD.",
        "Complete /auth/phone/begin and /auth/phone/confirm first to create a ChannelLink."
      ]
    },
