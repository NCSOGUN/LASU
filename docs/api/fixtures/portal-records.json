    },
    {
      "id": "portal-fields-put",
      "name": "Update field values",
      "method": "PUT",
      "path": "/me/fields",
      "summary": "Upsert one or more field values with optimistic concurrency.",
      "description": "Every key must be an active field definition and no value may be null. The patient profile version is incremented only when expected_version matches, otherwise 409 version_conflict is returned. Returns the full field state after the write.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "fields": {
          "full_name": "Bola Adeyemi",
          "date_of_birth": "1994-11-03",
          "allergies": [
            "Penicillin"
          ],
          "current_medications": [
            "Paracetamol as needed"
          ],
          "conditions": [
            "Asthma"
          ],
          "blood_group": "O+",
          "emergency_contact_name": "Tunde Adeyemi",
          "emergency_contact_phone": "+2348098765433",
          "weight": "64",
          "height": "168",
          "gender": "Female"
        },
        "expected_version": 1
      },
      "bodyFields": [
        {
          "name": "fields",
          "type": "object",
          "required": true,
          "description": "Map of field_key to non-null JSON value."
        },
        {
          "name": "expected_version",
          "type": "integer",
          "required": true,
          "description": "Current patient profile version; non-negative."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "The full field state with the incremented version.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "version": 2,
            "fields": [
              {
                "key": "full_name",
                "label": "Name",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 10,
                "value": "Bola Adeyemi",
                "field_version": 1
              },
              {
                "key": "date_of_birth",
                "label": "Date of birth",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 20,
                "value": "1994-11-03",
                "field_version": 2
              },
              {
                "key": "allergies",
                "label": "Allergies",
                "value_type": "STRING_ARRAY",
                "emergency_eligible": true,
                "sort_order": 30,
                "value": [
                  "Penicillin"
                ],
                "field_version": 1
              },
              {
                "key": "current_medications",
                "label": "Medications",
                "value_type": "STRING_ARRAY",
                "emergency_eligible": true,
                "sort_order": 40,
                "value": [
                  "Paracetamol as needed"
                ],
                "field_version": 1
              },
              {
                "key": "conditions",
                "label": "Conditions",
                "value_type": "STRING_ARRAY",
                "emergency_eligible": true,
                "sort_order": 50,
                "value": [
                  "Asthma"
                ],
                "field_version": 1
              },
              {
                "key": "blood_group",
                "label": "Blood group",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 60,
                "value": "O+",
                "field_version": 1
              },
              {
                "key": "emergency_contact_name",
                "label": "Contact name",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 70,
                "value": "Tunde Adeyemi",
                "field_version": 1
              },
              {
                "key": "emergency_contact_phone",
                "label": "Contact phone",
                "value_type": "STRING",
                "emergency_eligible": true,
                "sort_order": 80,
                "value": "+2348098765433",
                "field_version": 1
              },
              {
                "key": "weight",
                "label": "Weight",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 90,
                "value": "64",
                "field_version": 1
              },
              {
                "key": "height",
                "label": "Height",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 100,
                "value": "168",
                "field_version": 1
              },
              {
                "key": "gender",
                "label": "Gender",
                "value_type": "STRING",
                "emergency_eligible": false,
                "sort_order": 110,
                "value": "Female",
                "field_version": 1
              },
              {
                "key": "blood_pressure",
