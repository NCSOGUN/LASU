{
  "group": "Patient portal and protected records",
  "order": 20,
  "description": "Patient-controlled field sharing, emergency profile, patient codes, access grants, consent channels, audit history and practitioner record access.",
  "endpoints": [
    {
      "id": "portal-fields-get",
