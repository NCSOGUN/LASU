    {
      "id": "auth-phone-begin",
      "name": "Begin phone verification",
      "method": "POST",
      "path": "/auth/phone/begin",
      "summary": "Queue a six-digit SMS verification code.",
      "description": "Consumes any previous unconsumed PHONE_VERIFICATION challenge for the account, creates a new challenge with a 10-minute expiry and queues the SMS through the outbox. The code is never returned by the API.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "phone": "+2348012345678"
      },
      "bodyFields": [
        {
          "name": "phone",
          "type": "string",
          "required": true,
          "description": "E.164 phone, 8-15 digits after the plus."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Code queued; expires_in is 600 seconds.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "status": "sent",
            "expires_in": 600
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/phone/begin -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"phone\":\"+2348012345678\"}'",
      "notes": [
        "Returns 503 sms_unavailable if the outbox write fails."
      ]
    },
    {
      "id": "auth-phone-confirm",
      "name": "Confirm phone verification",
      "method": "POST",
      "path": "/auth/phone/confirm",
      "summary": "Verify the SMS code and activate a channel link.",
      "description": "Checks the latest unconsumed challenge for the phone digest. A correct code marks the account phone as verified and creates or reactivates a ChannelLink for the patient. A wrong code increments attempts and returns 400 invalid_code; after five attempts the challenge is unusable.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "phone": "+2348012345678",
        "code": "<otp-code>"
      },
      "bodyFields": [
        {
          "name": "phone",
          "type": "string",
          "required": true,
          "description": "Same E.164 phone used in /auth/phone/begin."
        },
        {
          "name": "code",
          "type": "string",
          "required": true,
          "description": "Six digits from the queued SMS."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Phone verified and channel link created.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "verified": true,
            "phone_verified_at": "2026-11-17T16:19:14.390Z"
          }
        },
        {
          "status": 400,
          "label": "Bad Request",
          "description": "Wrong, expired or exhausted verification code.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "invalid_code",
            "message": "Invalid or expired verification code",
            "request_id": "22d9449b-5ca4-4e4e-802b-cd61d64aaf0a"
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/phone/confirm -H 'authorization: Bearer <access-jwt>' -H 'content-type: application/json' -d '{\"phone\":\"+2348012345678\",\"code\":\"<otp-code>\"}'",
      "notes": [
        "OTP values are only available in the SMS outbox and must never be returned to clients.",
        "A verified phone is required before SMS/USSD consent endpoints can create a consent."
      ]
    }
  ]
}
