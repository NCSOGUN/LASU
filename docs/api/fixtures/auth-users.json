      "id": "users-me-avatar",
      "name": "Upload an avatar",
      "method": "POST",
      "path": "/me/avatar",
      "summary": "Upload a profile image as multipart/form-data.",
      "description": "Accepts one image field, resizes it to 500px wide WebP and stores it in S3. This environment has no S3 credentials configured, so the endpoint returns 503 storage_unavailable before reading the file. A missing file returns 400 image_required when storage is configured.",
      "auth": "bearer",
      "roles": [],
      "contentType": "multipart/form-data",
      "bodyFields": [
        {
          "name": "image",
          "type": "file",
          "required": true,
          "description": "Image file up to 5 MB."
        }
      ],
      "responses": [
        {
          "status": 503,
          "label": "Service Unavailable",
          "description": "Object storage is not configured in this environment.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "storage_unavailable",
            "message": "File storage is not configured",
            "request_id": "234280c0-1b4e-42b1-9802-c978d7f7d132"
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/me/avatar -H 'authorization: Bearer <access-jwt>' -F 'image=@avatar.png'",
      "notes": [
        "Success response when storage is configured: { \"avatar_key\": \"avatars/<account-id>.webp\", \"avatar_url\": \"<presigned-url>\" }.",
        "Multer errors are reported as 400 invalid_upload."
      ]
    },
