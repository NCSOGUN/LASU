    {
      "id": "users-me-medical-put",
      "name": "Replace medical details",
      "method": "PUT",
      "path": "/me/medical",
      "summary": "Upsert medical fields and replace allergies and medical events.",
      "description": "Writes height, weight, gender, blood type, genotype, blood pressure, conditions, medications and emergency contacts as field values. When allergies or medicalEvents are arrays they replace all existing rows for the patient. Severity is normalised to MILD, MODERATE or SEVERE. Returns the full profile payload.",
