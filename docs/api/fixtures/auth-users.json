      ],
      "curl": "curl -sS -X GET http://localhost:3000/v1/me -H 'authorization: Bearer <access-jwt>'",
      "notes": [
        "field_values is a convenience map of field key to stored JSON value; fields carries labels and types.",
        "avatar_url is null when no avatar is stored or S3 is not configured."
      ]
    },
    {
      "id": "users-me-patch",
      "name": "Update the current profile",
      "method": "PATCH",
      "path": "/me",
      "summary": "Partially update account and patient fields.",
      "description": "Updates the account display name from firstName/lastName, email, phone digest, password and any provided patient fields. Only field keys present in field_definitions are written, so city/state/country are silently skipped when no definition exists. Returns the full profile payload.",
      "auth": "bearer",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "firstName": "Ada",
        "lastName": "Okafor",
        "city": "Ikeja",
        "state": "Lagos",
        "country": "Nigeria"
      },
      "bodyFields": [
        {
          "name": "firstName",
          "type": "string",
          "required": false,
          "description": "Updates display_name and full_name."
        },
        {
          "name": "lastName",
          "type": "string",
          "required": false,
          "description": "Updates display_name and full_name."
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "description": "New unique email; clears email_verified_at when changed."
        },
        {
          "name": "phone",
          "type": "string",
          "required": false,
          "description": "E.164 phone; clears phone_verified_at when the digest changes."
        },
        {
          "name": "dob",
          "type": "string",
          "required": false,
          "description": "ISO date stored as date_of_birth."
        },
        {
          "name": "city",
          "type": "string",
          "required": false,
          "description": "Stored only when a matching field definition exists."
        },
        {
          "name": "state",
          "type": "string",
          "required": false,
          "description": "Stored only when a matching field definition exists."
        },
        {
          "name": "country",
          "type": "string",
          "required": false,
          "description": "Stored only when a matching field definition exists."
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "description": "8-128 characters; rehashed with bcrypt."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "The full profile payload after the patch.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
