{
  "group": "Authentication and profile",
  "order": 10,
  "description": "Account registration, session tokens, the authenticated profile, phone verification and medical-record editing. All /me endpoints require a Bearer access token.",
  "endpoints": [
    {
      "id": "auth-register",
      "name": "Register a patient account",
      "method": "POST",
      "path": "/auth/register",
      "summary": "Create a patient account and issue a token pair.",
      "description": "Creates an ACTIVE account, assigns the PATIENT role, creates a patient profile and optionally stores date_of_birth as a field value. Email is trimmed and lower-cased. A duplicate email returns 409 email_taken.",
      "auth": "none",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "firstName": "Ada",
        "lastName": "Okafor",
        "email": "ada.okafor@example.test",
        "password": "DemoPass123!",
        "password_confirmation": "DemoPass123!",
        "dob": "1990-05-12",
        "phone": "+2348012345678"
      },
      "bodyFields": [
        {
          "name": "firstName",
          "type": "string",
          "required": true,
          "description": "1-100 characters after trimming."
        },
        {
          "name": "lastName",
          "type": "string",
          "required": true,
          "description": "1-100 characters after trimming."
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "Valid email, max 320 characters. Stored lower-case."
        },
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "8-128 characters."
        },
        {
          "name": "password_confirmation",
          "type": "string",
          "required": true,
          "description": "Must match password."
        },
        {
          "name": "dob",
          "type": "string",
          "required": false,
          "description": "ISO date; stored as a date_of_birth field value when the definition exists."
        },
        {
          "name": "phone",
          "type": "string",
          "required": false,
          "description": "E.164 phone, for example +2348012345678. Only the phone digest is stored."
        }
      ],
      "responses": [
        {
          "status": 201,
          "label": "Created",
          "description": "Account, assigned roles and a fresh token pair.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "account": {
              "id": "d2e6b647-3603-4b55-80e7-cf6c67f5816b",
              "email": "ada.okafor@example.test",
              "display_name": "Ada Okafor",
              "status": "ACTIVE",
              "idp_subject": null,
              "avatar_key": null,
              "email_verified_at": null,
              "phone_verified_at": null,
              "created_at": "2026-11-17T16:19:13.699Z",
              "updated_at": "2026-11-17T16:19:13.699Z"
            },
            "roles": [
              "PATIENT"
            ],
            "tokens": {
              "access_token": "<access-jwt>",
              "refresh_token": "<refresh-token>",
              "token_type": "Bearer",
              "expires_in": 900,
              "refresh_expires_in": 2591999
            }
          }
        },
        {
          "status": 400,
          "label": "Bad Request",
          "description": "Zod validation issues, one entry per invalid field.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "validation_error",
            "request_id": "52ad4de1-917b-4f0c-a43a-a463d201524e",
            "issues": [
              {
                "path": "firstName",
                "message": "String must contain at least 1 character(s)"
              },
              {
                "path": "lastName",
                "message": "String must contain at least 1 character(s)"
              },
              {
                "path": "email",
                "message": "Invalid email"
              },
              {
                "path": "password",
                "message": "String must contain at least 8 character(s)"
              },
              {
                "path": "password_confirmation",
                "message": "Passwords do not match"
              }
            ]
          }
        },
        {
          "status": 409,
          "label": "Conflict",
          "description": "The email is already registered.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "email_taken",
            "message": "This email is already registered",
            "request_id": "5018c51d-fe57-4354-b054-52f7d4207c7b"
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/register -H 'content-type: application/json' -d '{\"firstName\":\"Ada\",\"lastName\":\"Okafor\",\"email\":\"ada.okafor@example.test\",\"password\":\"DemoPass123!\",\"password_confirmation\":\"DemoPass123!\",\"dob\":\"1990-05-12\",\"phone\":\"+2348012345678\"}'",
      "notes": [
        "Access tokens expire in 900 seconds; refresh tokens expire in about 30 days.",
        "The access token is a JWT whose roles are read from the database on every request."
      ]
    },
    {
      "id": "auth-login",
      "name": "Log in",
      "method": "POST",
      "path": "/auth/login",
      "summary": "Exchange email and password for a token pair.",
      "description": "Looks up the account by lower-cased email, verifies the bcrypt password hash and issues a new session. Returns 401 invalid_credentials for an unknown email or bad password and 403 account_inactive for a non-ACTIVE account.",
      "auth": "none",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "email": "demo.patient@example.test",
        "password": "DemoPass123!"
      },
      "bodyFields": [
        {
          "name": "email",
          "type": "string",
          "required": true,
          "description": "Registered email; trimmed and lower-cased."
        },
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "1-128 characters."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "Account summary for the seeded demo patient, current roles and a new token pair. Tokens are placeholders.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "account": {
              "id": "20000000-0000-4000-8000-000000000004",
              "email": "demo.patient@example.test",
              "display_name": "Demo Patient",
              "status": "ACTIVE",
              "idp_subject": null,
              "avatar_key": null,
              "email_verified_at": null,
              "phone_verified_at": null,
              "created_at": "2026-11-17T15:43:52.132Z",
              "updated_at": "2026-11-17T16:02:02.106Z"
            },
            "roles": [
              "PATIENT"
            ],
            "tokens": {
              "access_token": "<access-jwt>",
              "refresh_token": "<refresh-token>",
              "token_type": "Bearer",
              "expires_in": 900,
              "refresh_expires_in": 2591999
            }
          }
        },
        {
          "status": 401,
          "label": "Unauthorized",
          "description": "Unknown email or wrong password; the message is intentionally identical for both.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "error": "invalid_credentials",
            "message": "Invalid email or password",
            "request_id": "e3582fea-334b-4688-a9ca-a6e6f7553b87"
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/login -H 'content-type: application/json' -d '{\"email\":\"demo.patient@example.test\",\"password\":\"DemoPass123!\"}'",
      "notes": [
        "Uses the seeded demo patient (demo.patient@example.test). Run npm run db:seed if the account is missing.",
        "Roles in the access token are the roles returned by this call.",
        "The 200 example shows the demo account; captured access and refresh tokens are replaced with placeholders."
      ]
    },
    {
      "id": "auth-refresh",
      "name": "Rotate a refresh token",
      "method": "POST",
      "path": "/auth/refresh",
      "summary": "Exchange a refresh token for a new token pair.",
      "description": "Refresh tokens are single-use: a successful call replaces the stored hash, so the submitted refresh token can no longer be used. Returns 401 invalid_refresh_token when the token is unknown, revoked, expired or the account is not ACTIVE.",
      "auth": "none",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "refresh_token": "<refresh-token>"
      },
      "bodyFields": [
        {
          "name": "refresh_token",
          "type": "string",
          "required": true,
          "description": "Opaque refresh token from register/login/refresh."
        }
      ],
      "responses": [
        {
          "status": 200,
          "label": "OK",
          "description": "A new token pair; the previous refresh token is invalidated.",
          "headers": {
            "content-type": "application/json; charset=utf-8"
          },
          "body": {
            "tokens": {
              "access_token": "<access-jwt>",
              "refresh_token": "<refresh-token>",
              "token_type": "Bearer",
              "expires_in": 900,
              "refresh_expires_in": 2591999
            }
          }
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/refresh -H 'content-type: application/json' -d '{\"refresh_token\":\"<refresh-token>\"}'",
      "notes": [
        "Persist the returned refresh_token immediately; the submitted one stops working."
      ]
    },
    {
      "id": "auth-logout",
      "name": "Log out",
      "method": "POST",
      "path": "/auth/logout",
      "summary": "Revoke a refresh token and its session.",
      "description": "Marks the session matching the refresh token as revoked. The call returns 204 whether or not a matching active session existed. Access tokens for the revoked session stop passing requireAuth immediately because the session is checked on every request.",
      "auth": "none",
      "roles": [],
      "contentType": "application/json",
      "bodyExample": {
        "refresh_token": "<refresh-token>"
      },
      "bodyFields": [
        {
          "name": "refresh_token",
          "type": "string",
          "required": true,
          "description": "Refresh token to revoke."
        }
      ],
      "responses": [
        {
          "status": 204,
          "label": "No Content",
          "description": "Session revoked; the response has no body.",
          "headers": {},
          "body": null
        }
      ],
      "curl": "curl -sS -X POST http://localhost:3000/v1/auth/logout -H 'content-type: application/json' -d '{\"refresh_token\":\"<refresh-token>\"}'",
      "notes": [
        "Drop both tokens client-side after this call."
      ]
    },
    {
